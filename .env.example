# ─────────────────────────────────────────────
# Ehe Hair — Environment Variable Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────

# ── Stripe ────────────────────────────────────
# Server-only secret key (sk_test_... or sk_live_...)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE

# Public-facing publishable key (pk_test_... or pk_live_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE

# ── App URL ───────────────────────────────────
# Used to build Stripe success_url and cancel_url.
# Local dev: http://localhost:3000
# Production: https://ehehair.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Contact Form (Formspree) ──────────────────
# Sign up at https://formspree.io and create a form.
# The form ID is the last segment of your endpoint URL:
#   https://formspree.io/f/YOUR_FORM_ID
NEXT_PUBLIC_FORMSPREE_ID=YOUR_FORMSPREE_FORM_ID
